{
  "name": "agent-forge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n java,engine,web -c blue,magenta,green \"npm:dev:api\" \"npm:dev:engine\" \"npm:dev:web\"",
    "dev:api": "cd backend && mvnw.cmd spring-boot:run",
    "dev:engine": "agent-engine\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --app-dir agent-engine",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "cd backend && mvnw.cmd spring-boot:run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
